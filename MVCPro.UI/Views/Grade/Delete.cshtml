@model MVCPro.BLL.ViewModels.GradeVM

<h2>Delete Grade</h2>
<div class="alert alert-danger">
    Are you sure you want to delete this grade for @Model.UserName in @Model.CourseName?
</div>
<form asp-action="ConfirmDelete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">Delete</button>
    <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
</form>
