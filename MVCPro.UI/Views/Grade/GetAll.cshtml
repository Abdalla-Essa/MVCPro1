@model MVCPro.BLL.Helpers.PaginatedList<MVCPro.BLL.ViewModels.GradeVM>

@{
    ViewData["Title"] = "Grades";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">🎓 Grades List</h2>
        <a class="btn btn-primary shadow-sm" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Add New Grade
        </a>
    </div>

    <div class="row g-4">
        @foreach (var grade in Model)
        {
            <div class="col-md-4">
                <div class="card shadow border-0 h-100" style="background: #f0f8ff;">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title fw-bold text-primary">@grade.UserName</h5>
                            @if (grade.Score >= 85)
                            {
                                <span class="badge bg-success fs-6">@grade.Score</span>
                            }
                            else if (grade.Score >= 60)
                            {
                                <span class="badge bg-warning text-dark fs-6">@grade.Score</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">@grade.Score</span>
                            }
                        </div>

                        <p class="card-text mb-2 text-secondary">
                            <i class="bi bi-journal-bookmark"></i>
                            <span class="fw-semibold">Course:</span> @grade.CourseName
                        </p>

                        <p class="card-text text-muted flex-grow-1">
                            <i class="bi bi-chat-left-text"></i>
                            <span class="fw-semibold">Remarks:</span> @(grade.Remarks?.Replace("_", " ") ?? "-")
                        </p>

                        <div class="mt-auto d-flex justify-content-between">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Update" asp-route-id="@grade.Id">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@grade.Id"
                               onclick="return confirm('Are you sure you want to delete this grade?');">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link text-primary" asp-action="GetAll" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link @(i == Model.PageIndex ? "bg-primary text-white" : "text-primary")"
                       asp-action="GetAll" asp-route-pageIndex="@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link text-primary" asp-action="GetAll" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>
