@model MVCPro.BLL.ViewModels.CourseDetailsVM

@{
    ViewData["Title"] = "Delete Course";
}

<h2>Delete Course</h2>

<p>Are you sure you want to delete this course?</p>

<div class="card p-3 mb-3">
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Category:</strong> @Model.Category</p>
    <p><strong>Instructor:</strong> @Model.InstructorName</p>
    <p><strong>Start Date:</strong> @Model.StartDate.ToShortDateString()</p>
    <p><strong>End Date:</strong> @Model.EndDate.ToShortDateString()</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
</form>
