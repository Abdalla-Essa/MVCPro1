@model MVCPro.BLL.ViewModels.SessionVM

<h2>Delete Session</h2>
<div class="alert alert-danger">
    Are you sure you want to delete session "@Model.Title" for course "@Model.CourseName"?
</div>
<form asp-action="ConfirmDelete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">Delete</button>
    <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
</form>
